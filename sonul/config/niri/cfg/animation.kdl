    animations {
        workspace-switch {
            spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
        }
        window-open {
            spring damping-ratio=0.75 stiffness=800 epsilon=0.0001
            custom-shader path="../shaders/bloom-open.glsl"
        }
        window-close {
            spring damping-ratio=1.0 stiffness=1200 epsilon=0.0001
            custom-shader path="../shaders/bloom-close.glsl"
        }
        horizontal-view-movement {
            spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
        }
        window-movement {
            spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
        }
        window-resize {
            spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
            custom-shader path="../shaders/squash-resize.glsl"
        }
        config-notification-open-close {
            spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
        }
        screenshot-ui-open {
            duration-ms 300
            curve "ease-out-quad"
        }
        overview-open-close {
            spring damping-ratio=0.85 stiffness=650 epsilon=0.0001
        }
    }
